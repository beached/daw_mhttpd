@PACKAGE_INIT@

include( CMakeFindDependencyMacro )
find_dependency( daw-header-libraries )
find_dependency( daw-integer )
# Must be built with SPDLOG_USE_STD_FORMAT; daw_mhttpd_log.h checks
find_dependency( spdlog CONFIG )
set( DAW_MHTTPD_ENABLE_ZSTD @DAW_MHTTPD_ENABLE_ZSTD@ )
if( DAW_MHTTPD_ENABLE_ZSTD )
	find_dependency( zstd CONFIG )
endif()

# A static daw-mhttpd still has to link libmicrohttpd
set( DAW_MHTTPD_STATIC_MHD @DAW_MHTTPD_STATIC_MHD@ )
include( "${CMAKE_CURRENT_LIST_DIR}/daw_mhttpd_find_mhd.cmake" )
if( NOT MHD_FOUND )
	set( daw-mhttpd_FOUND FALSE )
	set( daw-mhttpd_NOT_FOUND_MESSAGE "libmicrohttpd 1.0 or newer was not found with pkg-config" )
	return()
endif()

include( "${CMAKE_CURRENT_LIST_DIR}/daw-mhttpdTargets.cmake" )

check_required_components( daw-mhttpd )
